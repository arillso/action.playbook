{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": ["github>arillso/.github:renovate-actions#2026-11-07"],
    "packageRules": [
        {
            "description": "Alpine packages (repology)",
            "matchManagers": ["custom.regex"],
            "matchDatasources": ["repology"],
            "matchPackageNames": ["/^alpine_3_24\\//"],
            "groupName": "Alpine packages"
        },
        {
            "description": "Go toolchain: go directive and golang builder image in one PR. If the image digest lags the directive, the PR stays red only until Renovate adds the digest to the same branch, instead of a separate directive PR that never gets rebased",
            "matchManagers": ["gomod", "dockerfile"],
            "matchDepNames": ["go", "golang"],
            "groupName": "golang",
            "groupSlug": "golang"
        }
    ],
    "customManagers": [
        {
            "customType": "regex",
            "managerFilePatterns": ["/^Dockerfile$/"],
            "matchStrings": [
                "(?:RUN\\s+(?:apk update\\s+&&\\s+)?apk add --no-cache\\s+|\\\\\\s+)(?<depName>[a-z][a-z0-9-]*)(=(?<currentValue>[a-zA-Z0-9-._]+))?"
            ],
            "versioningTemplate": "loose",
            "datasourceTemplate": "repology",
            "packageNameTemplate": "alpine_3_24/{{depName}}"
        }
    ]
}
